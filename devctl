#!/usr/bin/env python3
"""Build or invoke the installed controller in this framework checkout."""

import os
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parent
if sys.argv[1:2] == ["setup"]:
    python = sys.executable if sys.version_info >= (3, 12) else ">=3.12"
    os.execvp("uv", ["uv", "run", "--no-project", "--python", python, "--",
                     str(root / "scripts/build_controller.py"), *sys.argv[2:]])
selected = os.environ.get("DEVCTL_CONTROLLER", str(root / ".controller/bin/devctl"))
if not Path(selected).is_absolute() or not Path(selected).is_file() or not os.access(selected, os.X_OK):
    print("Run ./devctl setup in the rapid-ship checkout first.", file=sys.stderr)
    sys.exit(2)
try:
    version = subprocess.run([selected, "--version"], capture_output=True, text=True, timeout=10)
except (OSError, subprocess.TimeoutExpired) as error:
    print(f"Cannot check controller: {error}", file=sys.stderr)
    sys.exit(2)
if version.returncode or version.stdout.strip() != "devctl 0.1.0":
    print("Expected devctl 0.1.0. Review the checkout and run ./devctl setup --rebuild.", file=sys.stderr)
    sys.exit(2)
os.execv(selected, [selected, *sys.argv[1:]])
