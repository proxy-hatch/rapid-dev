#!/usr/bin/env python3
"""Forward project commands to the installed rapid-ship controller."""

import json
import os
import subprocess
import sys
from pathlib import Path


def main():
    selected = os.environ.get("DEVCTL_CONTROLLER")
    if selected is None:
        try:
            link = Path(__file__).resolve().parent / ".devctl/local.json"
            selected = json.loads(link.read_text()).get("controller")
        except (OSError, ValueError, AttributeError):
            selected = None
    if not isinstance(selected, str) or not Path(selected).is_absolute():
        sys.exit("Set up this project through rapid-ship, or set DEVCTL_CONTROLLER to an absolute path.")
    if not Path(selected).is_file() or not os.access(selected, os.X_OK):
        sys.exit("DEVCTL_CONTROLLER must name an executable installed controller file.")
    try:
        version = subprocess.run([selected, "--version"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        sys.exit("The controller version must be devctl 0.1.0. Run setup in its framework checkout.")
    if version.returncode or version.stdout.strip() != "devctl 0.1.0":
        sys.exit("The controller version must be devctl 0.1.0. Run setup in its framework checkout.")
    os.execv(selected, [selected, *sys.argv[1:]])


if __name__ == "__main__":
    try:
        main()
    except SystemExit as error:
        if isinstance(error.code, str):
            print(error.code, file=sys.stderr)
            sys.exit(2)
        raise
